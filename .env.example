# Local demo needs no credentials. Copy to .env to override defaults.
MODE=demo
ROLE=all
HOST=127.0.0.1
PORT=4100
PUBLIC_URL=http://localhost:3000
API_BASE=http://127.0.0.1:4100
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DEMO_DATA_PATH=../../.data/demo.json
LOG_LEVEL=info
FETCH_CONCURRENCY=4

# Production: MODE=production; PUBLIC_URL=https://your-domain.example
# PostgreSQL URL password must be URL encoded; container host is postgres.
# DATABASE_URL=postgresql://feedrelay:REPLACE@postgres:5432/feedrelay
# BOT_TOKEN=obtained-from-BotFather
# BOT_ID=numeric-id-returned-by-getMe
# BOT_USERNAME=YourFeedRelayBot
# WEBHOOK_SECRET=generate-at-least-32-random-characters
# TELEGRAM_CLIENT_ID=from-BotFather-Login-Widget
# TELEGRAM_CLIENT_SECRET=from-BotFather-Login-Widget
# Register PUBLIC_URL/api/auth/telegram/callback in BotFather.

# Free mode is fully usable while billing remains off.
BILLING_ENABLED=false
STARTER_STARS=300
SUPPORT_EMAIL=
TERMS_URL=

# Production Compose additional variables:
# DOMAIN=your-domain.example
# ACME_EMAIL=your-certificate-contact@example.com
# POSTGRES_DB=feedrelay
# POSTGRES_USER=feedrelay
# POSTGRES_PASSWORD=strong-random-password
